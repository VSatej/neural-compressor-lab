{
  "name": "nuxtseo-shared",
  "type": "module",
  "version": "6.0.3",
  "description": "Shared utilities for Nuxt SEO modules.",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/harlan-zw",
  "homepage": "https://nuxtseo.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/nuxt-seo.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/harlan-zw/nuxt-seo/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "default": "./dist/module.mjs"
    },
    "./content": {
      "types": "./dist/content.d.mts",
      "default": "./dist/content.mjs"
    },
    "./content-runtime": {
      "types": "./dist/content-runtime.d.mts",
      "default": "./dist/content-runtime.mjs"
    },
    "./kit": {
      "types": "./dist/kit.d.mts",
      "default": "./dist/kit.mjs"
    },
    "./devtools": {
      "types": "./dist/devtools.d.mts",
      "default": "./dist/devtools.mjs"
    },
    "./i18n": {
      "types": "./dist/i18n.d.mts",
      "default": "./dist/i18n.mjs"
    },
    "./i18n-runtime": {
      "types": "./dist/i18n-runtime.d.mts",
      "default": "./dist/i18n-runtime.mjs"
    },
    "./pro": {
      "types": "./dist/pro.d.mts",
      "default": "./dist/pro.mjs"
    },
    "./utils": {
      "types": "./dist/utils.d.mts",
      "default": "./dist/utils.mjs"
    },
    "./const": {
      "types": "./dist/const.d.mts",
      "default": "./dist/const.mjs"
    },
    "./brand": {
      "types": "./dist/brand.d.mts",
      "default": "./dist/brand.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "default": "./dist/server.mjs"
    },
    "./fetch": {
      "types": "./dist/fetch.d.mts",
      "default": "./dist/fetch.mjs"
    },
    "./prerender": {
      "types": "./dist/prerender.d.mts",
      "default": "./dist/prerender.mjs"
    },
    "./package.json": "./package.json",
    "./checklist": {
      "types": "./dist/checklist.d.mts",
      "default": "./dist/checklist.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "peerDependencies": {
    "@nuxt/schema": "^4.6.0 || ^5.0.0",
    "nuxt": "^4.6.0 || ^5.0.0",
    "nuxt-site-config": "^5.0.0",
    "vue": "^3.5.0",
    "zod": "^3.23.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "nuxt-site-config": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.1",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "ofetch": "^1.5.1",
    "radix3": "^1.1.2",
    "std-env": "^4.3.0",
    "ufo": "^1.6.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@harlan-zw/comark-content": "^0.2.0",
    "@nuxt/content": "^3.16.1",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.1",
    "@nuxt/test-utils": "^4.3.3",
    "@nuxtjs/i18n": "^10.6.0",
    "h3": "^2.0.1",
    "nitropack": "^2.13.4",
    "nuxt": "^4.6.1",
    "nuxt-site-config": "^5.0.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "dev:prepare": "nuxt-module-build prepare",
    "stub": "nuxt-module-build build --stub",
    "test": "vitest",
    "test:run": "vitest run && pnpm test:nuxt5",
    "test:nuxt5": "pnpm build && pnpm --dir test/fixtures/nitro-compat-nuxt5 install --frozen-lockfile && pnpm --dir test/fixtures/nitro-compat-nuxt5 test",
    "test:attw": "attw --pack --profile esm-only",
    "typecheck": "nuxt typecheck ."
  }
}